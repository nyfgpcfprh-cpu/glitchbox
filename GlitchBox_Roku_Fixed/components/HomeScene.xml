<?xml version="1.0" encoding="utf-8"?>
<component name="HomeScene" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/HomeScene.brs" />
  <interface>
    <field id="selectedItem" type="assocarray" />
    <field id="playNow" type="assocarray" />
    <field id="serverHost" type="string" />
    <field id="openSettings" type="boolean" />
    <field id="openSearch" type="boolean" />
    <field id="openLibrary" type="boolean" />
    <field id="selectedLibraryId" type="string" />
    <field id="libraries" type="array" />
    <field id="syncRequested" type="boolean" />
    <field id="lastSync" type="string" />
  </interface>

  <children>
    <Rectangle id="bg" width="1280" height="720" color="#0B0B10" />

    <!-- Left rail this is where the navigation list is -->
    <Group id="leftRail" translation="[40, 40]">
      <Rectangle id="railBg" translation="[0, 0]" width="220" height="640" color="#121218" opacity="0.9" />
      <Label id="brand" translation="[0, 0]" text="GlitchBox" font="font:LargeSystemFont" color="#FFFFFF" />
      
      <LabelList
        id="navList"
        translation="[0, 60]"
        itemSize="[180, 40]"
        itemSpacing="[0, 8]"
        font="font:MediumSystemFont"
        color="#B8B8C5"
        focusedColor="#FFD54A"
        focusBitmapBlendColor="#000000"
        visible="true" />

    </Group>


    <!-- Content rows -->
    <RowList
      id="rows"
      translation="[280, 190]"
      itemComponentName="RowListItem"
      rowItemSize="[[240, 135]]"
      itemSpacing="[12, 0]"
      rowItemSpacing="[[12, 0]]"
      rowHeights="[160]"
      rowLabelColor="#FFFFFF"
      rowLabelFont="font:MediumSystemFont"
      drawFocusFeedback="true"
      vertFocusAnimationStyle="floatingFocus"
      showRowLabel="[true]"
      visible="true" />

    <Label id="status" translation="[280, 680]" text="Select an item to view details" font="font:SmallSystemFont" color="#B8B8C5" />

    <LoadingOverlay id="loadingOverlay" visible="false" />

  </children>
</component>
