<?xml version="1.0" encoding="utf-8"?>
<component name="SearchScene" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/SearchScene.brs" />
  <interface>
    <field id="serverHost" type="string" />
    <field id="libraryId" type="string" />
    <field id="libraries" type="array" />
    <field id="selectedItem" type="assocarray" />
    <field id="backRequested" type="boolean" />
  </interface>

  <children>
    <Rectangle id="bg" width="1280" height="720" color="#0B0B10" />
    <Label id="title" translation="[60, 40]" text="Search" font="font:LargeSystemFont" color="#FFFFFF" />
    <Label id="subtitle" translation="[60, 90]" text="Enter a query to search" font="font:MediumSystemFont" color="#CCCCCC" />

    <ButtonGroup
      id="actions"
      translation="[60, 140]" />

    <Label id="status" translation="[60, 200]" text="" font="font:SmallSystemFont" color="#B8B8C5" />
    <Label id="scopeLabel" translation="[360, 200]" text="Scope: Current Library" font="font:SmallSystemFont" color="#B8B8C5" />
    <Label id="pageLabel" translation="[700, 200]" text="Page: 1" font="font:SmallSystemFont" color="#B8B8C5" />

    <RowList
      id="results"
      translation="[60, 240]"
      itemComponentName="RowListItem"
      rowItemSize="[[240, 135]]"
      itemSpacing="[12, 0]"
      rowItemSpacing="[[12, 0]]"
      rowHeights="[160]"
      rowLabelColor="#FFFFFF"
      rowLabelFont="font:MediumSystemFont"
      drawFocusFeedback="true"
      vertFocusAnimationStyle="floatingFocus"
      showRowLabel="[false]"
      visible="true" />

    <ErrorDialog id="errorDialog" visible="false" />
  </children>
</component>
